\n        \"aiSummary\": {\n          \"type\": \"string\",\n          \"description\": \"AI-generated executive summary of the meeting highlights and key takeaways.\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"description\": \"Timestamp indicating document creation time.\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"description\": \"Timestamp indicating document modification time.\"\n        }\n      },\n      \"required\": [\"id\", \"title\", \"date\", \"attendees\"]\n    },\n    \"TranscriptItem\": {\n      \"title\": \"Transcript Item\",\n      \"description\": \"A single spoken line or block of dialogue emitted during a meeting session.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"description\": \"Unique dialogue segment identifier.\"\n        },\n        \"timestamp\": {\n          \"type\": \"string\",\n          \"description\": \"Wall-clock time string (e.g. HH:MM:SS).\"\n        },\n        \"relativeTime\": {\n          \"type\": \"string\",\n          \"description\": \"Relative offset time string since meeting start.\"\n        },\n        \"speakerId\": {\n          \"type\": \"string\",\n          \"description\": \"The target ID of the speaking attendee.\"\n        },\n        \"text\": {\n          \"type\": \"string\",\n          \"description\": \"The exact synthesized/recognized speech content.\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"description\": \"Database insertion timestamp.\"\n        }\n      },\n      \"required\": [\"id\", \"timestamp\", \"relativeTime\", \"speakerId\", \"text\"]\n    }\n  },\n  \"firestore\": {\n    \"/users/{userId}\": {\n      \"schema\": \"User\",\n      \"description\": \"Contains user registration profiles.\"\n    },\n    \"/users/{userId}/meetings/{meetingId}\": {\n      \"schema\": \"Meeting\",\n      \"description\": \"Stored meetings linked to an authenticated user ID.\"\n    },\n    \"/users/{userId}/meetings/{meetingId}/transcript/{itemId}\": {\n      \"schema\": \"TranscriptItem\",\n      \"description\": \"The full spoken dialogue logs/transcript items for each meeting.\"\n    }\n  }\n}\n"
    }
