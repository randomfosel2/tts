steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1779768188
      nanos: 684180000
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1779768188
      nanos: 684180000
    }
  }
  file_change {
    absolute_path_uri: "file:///security_spec.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "# Firestore Security Specification & Vulnerability Test Suite"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This specification defines the strict security guidelines, data invariants, and adversarial test cases designed to verify the robust access controls of our Firestore database."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. Data Invariants"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Ownership Multi-Tenancy**: Data under `/users/{userId}/...` is locked exclusively to `/users/{userId}` where `request.auth.uid == userId`. No cross-user reads or writes are allowed."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Strict Registration Only**: All write operations require a verified email address (`request.auth.token.email_verified == true`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Meeting Structural Integrity**: Any meeting document must contain an `id`, a non-empty `title` (length <= 256), a localized `date` string, and an `attendees` list with at most 30 members."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Dialogue Immutability**: Spoken transcripts under a meeting can only be created. They cannot be modified or deleted."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Temporal Invariants**: All write transitions must securely apply `request.time` to tracking fields. Client-modified timestamps must be rejected immediately."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. The \"Dirty Dozen\" Threat Payloads"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Each of these represents a malicious payload constructed to attempt permission bypasses, ID poisoning, privilege escalation, or resource exhaustion."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 1: Profile Hijack (Writing to another user\'s root profile)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/attacker_uid` (Authenticated as `victim_uid`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `create` or `update`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Identity Spoofing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 2: Account Cloning (Forging profile details)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid` (Authenticated as `victim_uid`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `create` with `request.auth.token.email_verified == false`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Unauthorized registration of unverified email address"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 3: Unauthenticated Scraping (Read meetings of other users)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings` (Authenticated as `guest` or another UID)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `list` or `get`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Data Leakage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 4: Arbitrary Meeting Injection (Creating meeting under another user)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/some_meeting_id` (Authenticated as `attacker_uid`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `create`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Cross-tenant write injection"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 5: Meeting ID Poisoning (Creating meeting with extreme ID length)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/A_QUITE_LONG_JUNK_ID_TO_EXHAUST_RESOURCES_AND_POISON_THE_DATABASE_INDEXES_FOR_DENIAL_OF_WALLET`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `create`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Resource Poisoning via path variable abuse"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 6: Shadow State Injection (Adding admin attributes)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/meeting_1`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `create` with schema `{ isAdmin: true, bypassSecurity: true }`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Shadow/Ghost fields definition"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 7: Over-sized Meeting Title (Denial of Wallet)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/meeting_1`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `create` with title containing 1MB of text"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Payload resource exhaustion"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 8: Corrupt Attendee Matrix (Malformed attendee maps)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/meeting_1`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `update` with attendees list as a single plain string `\"all_everyone\"`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Schema validation bypass"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 9: Mutating Immutable Timeline Records (Edit final transcript)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/meeting_1/transcript/item_1`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `update`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Terminal State/Immutability violation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 10: Deleting Historical transcripts (Erase recorded dialogue)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/meeting_1/transcript/item_1`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `delete`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Erasure of compliance dialogue records"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 11: Hijacking Temporal Timestamps (Forging custom date)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/meeting_1`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Action**: `create` with `createdAt: \"2020-01-01T00:00:00Z\"`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Violation**: Timestamp spoofing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Payload 12: Injected HTML script in transcript text"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path**: `/users/victim_uid/meetings/meeting_1/transcript/item_1`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
