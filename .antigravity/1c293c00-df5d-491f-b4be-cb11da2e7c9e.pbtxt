    items {
      text: "\353\214\200\353\252\250\354\202\260 \355\230\270\355\205\224\354\202\254\354\227\205\353\266\200 PM\353\213\230, \353\213\265\353\263\200 \354\243\274\354\213\240 \353\202\264\354\232\251\354\235\204 \353\260\230\354\230\201\355\225\230\354\227\254 AI Studio(\353\230\220\353\212\224 Cursor, Windsurf \353\223\261\354\235\230 \352\260\234\353\260\234 \355\210\264)\354\227\220 \354\246\211\354\213\234 \354\236\205\353\240\245\355\225\264 \354\202\254\354\232\251\355\225\240\n\354\210\230 \354\236\210\353\212\224 \354\210\230\354\244\200\354\235\230 \352\265\254\354\262\264\354\240\201\354\235\264\352\263\240 \354\240\225\352\265\220\355\225\234 PRD\353\245\274 \354\236\221\354\204\261\355\226\210\354\212\265\353\213\210\353\213\244.\n\nWeb Speech API\354\235\230 \352\263\240\354\234\240\355\225\234 \355\225\234\352\263\204(\354\236\220\353\217\231 \354\242\205\353\243\214 \355\230\204\354\203\201, \353\260\261\352\267\270\353\235\274\354\232\264\353\223\234 \354\240\234\354\225\275 \353\223\261)\353\245\274 React \354\203\201\355\203\234 \352\264\200\353\246\254 \354\210\230\354\244\200\354\227\220\354\204\234 \353\260\251\354\226\264\355\225\240 \354\210\230 \354\236\210\353\217\204\353\241\235 \354\213\244\354\232\251\354\240\201\354\235\270 \354\230\210\354\231\270\n\354\262\230\353\246\254 \352\260\200\354\235\264\353\223\234\353\245\274 \355\217\254\355\225\250\355\226\210\354\212\265\353\213\210\353\213\244. \354\225\204\353\236\230 \354\275\224\353\223\234 \353\270\224\353\241\235\354\235\230 \353\202\264\354\232\251\354\235\204 \352\267\270\353\214\200\353\241\234 \353\263\265\354\202\254\355\225\230\354\227\254 AI \352\260\234\353\260\234 \353\217\204\352\265\254\354\227\220 \354\236\205\353\240\245\355\225\264 \353\263\264\354\213\234\352\270\260 \353\260\224\353\236\215\353\213\210\353\213\244.\n\n# [PRD] \353\214\200\353\252\250\354\202\260 \355\230\270\355\205\224\354\202\254\354\227\205\353\266\200 \354\213\244\354\213\234\352\260\204 STT \355\232\214\354\235\230\353\241\235 \354\236\221\354\204\261 \353\260\217 \352\264\200\353\246\254 \354\204\234\353\271\204\354\212\244\n\n\353\263\270 \353\254\270\354\204\234\353\212\224 Web Speech API\353\245\274 \355\231\234\354\232\251\355\225\230\354\227\254 \354\202\254\353\202\264 \355\232\214\354\235\230 \353\202\264\354\232\251\354\235\204 \354\213\244\354\213\234\352\260\204\354\234\274\353\241\234 \355\205\215\354\212\244\355\212\270\353\241\234 \353\263\200\355\231\230(STT)\355\225\230\352\263\240, \355\232\250\354\234\250\354\240\201\354\235\270 \355\232\214\354\235\230\353\241\235 \354\203\235\354\204\261\354\235\204 \354\247\200\354\233\220\355\225\230\353\212\224 React \352\270\260\353\260\230 \353\213\250\354\235\274 \355\216\230\354\235\264\354\247\200 \354\225\240\355\224\214\353\246\254\354\274\200\354\235\264\354\205\230(SPA) \352\260\234\353\260\234\354\235\204 \354\234\204\355\225\234 \354\240\234\355\222\210 \354\232\224\352\265\254\354\202\254\355\225\255 \354\240\225\354\235\230\354\204\234\354\236\205\353\213\210\353\213\244. AI Studio \353\223\261\354\235\230 LLM \352\260\234\353\260\234 \355\231\230\352\262\275\354\235\264 \354\246\211\354\213\234 \354\206\214\354\212\244 \354\275\224\353\223\234\353\245\274 \354\204\244\352\263\204\355\225\230\352\263\240 \352\265\254\355\230\204\355\225\240 \354\210\230 \354\236\210\353\217\204\353\241\235 \352\265\254\354\262\264\354\240\201\354\235\270 \352\270\260\353\212\245 \354\240\225\354\235\230 \353\260\217 \352\270\260\354\210\240\354\240\201 \354\230\210\354\231\270 \354\262\230\353\246\254 \353\260\251\354\225\210\354\235\204 \353\252\205\354\213\234\355\225\251\353\213\210\353\213\244.\n\n---\n\n## 1. \355\224\204\353\241\234\354\240\235\355\212\270 \352\260\234\354\232\224\n- **\354\204\234\353\271\204\354\212\244\353\252\205**: \353\214\200\353\252\250\354\202\260 \355\230\270\355\205\224 \354\213\244\354\213\234\352\260\204 AI \355\232\214\354\235\230\353\241\235 \354\213\234\354\212\244\355\205\234 (\352\260\200\354\271\255)\n- **\352\260\234\353\260\234 \355\231\230\352\262\275/\354\212\244\355\203\235**: React (Vite \352\266\214\354\236\245), Tailwind CSS, Lucide React (\354\225\204\354\235\264\354\275\230)\n- **\355\225\265\354\213\254 \353\252\251\355\221\234**: \n  - \354\231\270\353\266\200 API \353\271\204\354\232\251 \354\227\206\354\235\264 \354\233\271 \355\221\234\354\244\200 \352\270\260\354\210\240(Web Speech API)\354\235\204 \355\231\234\354\232\251\355\225\234 \354\213\244\354\213\234\352\260\204 \354\235\214\354\204\261-\355\205\215\354\212\244\355\212\270 \353\263\200\355\231\230.\n  - \355\232\214\354\235\230 \354\260\270\354\227\254\354\236\220\353\263\204 \353\260\234\354\226\270\354\235\204 \354\210\230\353\217\231\354\234\274\353\241\234 \353\266\204\353\246\254 \353\260\217 \352\270\260\353\241\235\355\225\230\354\227\254 \352\260\200\353\217\205\354\204\261 \355\231\225\353\263\264.\n  - \353\241\234\354\273\254 \355\231\230\352\262\275 \353\202\264 \354\225\210\354\240\204\355\225\234 \353\215\260\354\235\264\355\204\260 \353\263\264\354\241\264 \353\260\217 \353\213\244\354\226\221\355\225\234 \355\217\254\353\247\267\354\234\274\353\241\234\354\235\230 \354\266\234\353\240\245 \354\247\200\354\233\220.\n\n---\n\n## 2. \355\231\224\353\251\264 \352\265\254\354\204\261 \353\260\217 \353\240\210\354\235\264\354\225\204\354\233\203 (Layout UI/UX)\n\n\354\240\204\354\262\264 \355\231\224\353\251\264\354\235\200 \353\260\230\354\235\221\355\230\225\354\235\204 \352\263\240\353\240\244\355\225\234 \355\210\254\354\271\274\353\237\274(Two-Column) \353\240\210\354\235\264\354\225\204\354\233\203\354\234\274\353\241\234 \354\204\244\352\263\204\355\225\251\353\213\210\353\213\244.\n\n### 2.1 \354\202\254\354\235\264\353\223\234\353\260\224 (Sidebar)\n- **\355\232\214\354\235\230 \354\235\264\353\240\245 \352\264\200\353\246\254 \353\246\254\354\212\244\355\212\270**: \n  - \353\241\234\354\273\254 \354\212\244\355\206\240\353\246\254\354\247\200\354\227\220 \354\240\200\354\236\245\353\220\234 \354\235\264\354\240\204 \355\232\214\354\235\230\353\241\235 \353\252\251\353\241\235 (\353\202\240\354\247\234, \355\232\214\354\235\230 \354\240\234\353\252\251, \353\260\234\354\226\270 \354\232\224\354\225\275 \353\223\261 \355\221\234\354\213\234).\n  - \355\212\271\354\240\225 \355\225\255\353\252\251 \355\201\264\353\246\255 \354\213\234 \353\251\224\354\235\270 \355\231\224\353\251\264\354\227\220 \355\225\264\353\213\271 \353\215\260\354\235\264\355\204\260 \353\266\210\353\237\254\354\230\244\352\270\260 \352\270\260\353\212\245.\n  - \355\232\214\354\235\230 \352\270\260\353\241\235 \354\202\255\354\240\234 \352\270\260\353\212\245.\n- **\355\232\214\354\235\230 \354\260\270\354\204\235\354\236\220(\355\231\224\354\236\220) \352\264\200\353\246\254**:\n  - \355\230\204\354\236\254 \355\232\214\354\235\230 \354\260\270\354\204\235\354\236\220 \353\252\251\353\241\235 \352\264\200\353\246\254 (\354\266\224\352\260\200, \354\203\211\354\203\201 \354\247\200\354\240\225, \354\202\255\354\240\234).\n  - \352\270\260\353\263\270 \354\240\234\352\263\265 \355\231\224\354\236\220: \"\354\260\270\354\204\235\354\236\220 A\", \"\354\260\270\354\204\235\354\236\220 B\" (\354\202\254\354\232\251\354\236\220\352\260\200 \354\210\230\354\240\225 \353\260\217 \354\266\224\352\260\200 \352\260\200\353\212\245).\n\n### 2.2 \353\251\224\354\235\270 \354\273\250\355\205\220\354\270\240 \354\230\201\354\227\255 (Main Content)\n- **\354\203\201\353\213\250 \355\227\244\353\215\224**:\n  - \355\232\214\354\235\230 \354\240\234\353\252\251 \354\204\244\354\240\225 \353\260\217 \355\216\270\354\247\221 \355\225\204\353\223\234.\n  - \354\213\234\354\212\244\355\205\234 \354\203\201\355\203\234 \355\221\234\354\213\234\354\244\204:\n    - \353\270\214\353\235\274\354\232\260\354\240\200 \355\230\270\355\231\230\354\204\261 \352\262\275\352\263\240 \353\260\260\353\204\210 (Chrome/Edge \354\231\270 \354\240\221\354\206\215 \354\213\234 \354\225\214\353\246\274).\n    - \353\247\210\354\235\264\355\201\254 \352\266\214\355\225\234 \354\203\201\355\203\234 \355\221\234\354\213\234.\n    - Web Speech API \354\236\221\353\217\231 \354\203\201\355\203\234 (\353\214\200\352\270\260 \354\244\221, \353\205\271\354\235\214 \354\244\221, \354\235\274\354\213\234\354\240\225\354\247\200).\n  - \354\273\250\355\212\270\353\241\244 \353\260\225\354\212\244: \353\205\271\354\235\214 \354\213\234\354\236\221(Start), \354\235\274\354\213\234\354\240\225\354\247\200(Pause), \353\205\271\354\235\214 \354\231\204\353\243\214 \353\260\217 \354\240\200\354\236\245(Save/Stop) \353\262\204\355\212\274.\n- **\354\244\221\354\225\231 \354\213\244\354\213\234\352\260\204 \355\203\200\354\236\204\353\235\274\354\235\270**:\n  - \355\231\225\354\240\225\353\220\234 \355\205\215\354\212\244\355\212\270 \353\270\224\353\241\235\353\223\244\354\235\264 \354\204\270\353\241\234 \355\224\274\353\223\234 \355\230\225\355\203\234\353\241\234 \353\205\270\354\266\234.\n  - \352\260\201 \353\270\224\353\241\235 \352\265\254\354\204\261: [\355\203\200\354\236\204\354\212\244\355\203\254\355\224\204] [\355\231\224\354\236\220 \354\204\240\355\203\235 \354\205\200\353\240\211\355\212\270 \353\260\225\354\212\244] [\354\210\230\354\240\225 \352\260\200\353\212\245\355\225\234 \355\205\215\354\212\244\355\212\270 \354\236\205\353\240\245\354\260\275] [\353\270\224\353\241\235 \354\202\255\354\240\234 \353\262\204\355\212\274].\n- **\355\225\230\353\213\250 \354\213\244\354\213\234\352\260\204 \355\224\204\353\246\254\353\267\260 \354\230\201\354\227\255**:\n  - \355\230\204\354\236\254 \354\235\270\354\213\235 \354\244\221\354\235\270 \354\244\221\352\260\204 \355\205\215\354\212\244\355\212\270(Interim Result)\352\260\200 \353\266\210\355\210\254\353\252\205\355\225\230\352\262\214 \354\213\244\354\213\234\352\260\204\354\234\274\353\241\234 \353\263\264\354\227\254\354\247\200\353\212\224 \354\230\201\354\227\255.\n- **\355\221\270\355\204\260**:\n  - \353\202\264\353\263\264\353\202\264\352\270\260 \353\262\204\355\212\274 \353\260\225\354\212\244: \"TXT \355\214\214\354\235\274 \353\213\244\354\232\264\353\241\234\353\223\234\", \"\355\201\264\353\246\275\353\263\264\353\223\234 \353\263\265\354\202\254(Markdown \355\217\254\353\247\267)\".\n  - \354\264\210\352\270\260\355\231\224 \353\262\204\355\212\274 (\355\230\204\354\236\254 \354\247\204\355\226\211 \354\244\221\354\235\270 \354\203\201\355\203\234\353\247\214 \354\264\210\352\270\260\355\231\224).\n\n---\n\n## 3. \355\225\265\354\213\254 \352\270\260\353\212\245 \354\232\224\352\265\254\354\202\254\355\225\255 (Core Functional Requirements)\n\n### 3.1 \353\270\214\353\235\274\354\232\260\354\240\200 \355\230\270\355\231\230\354\204\261 \353\260\217 \353\247\210\354\235\264\355\201\254 \352\266\214\355\225\234 \354\262\264\355\201\254\n- **\355\230\270\355\231\230\354\204\261 \352\262\200\354\246\235**: \354\225\261 \354\264\210\352\270\260 \353\241\234\353\223\234 \354\213\234 `window.SpeechRecognition` \353\230\220\353\212\224 `window.webkitSpeechRecognition` \354\241\264\354\236\254 \354\227\254\353\266\200\353\245\274 \355\231\225\354\235\270\355\225\251\353\213\210\353\213\244.\n  - \353\271\204\355\230\270\355\231\230 \353\270\214\353\235\274\354\232\260\354\240\200(\354\230\210: Safari \352\265\254\353\262\204\354\240\204, Firefox \353\223\261)\353\241\234 \354\240\221\354\206\215 \354\213\234 \355\231\224\353\251\264 \354\203\201\353\213\250\354\227\220 \353\252\205\355\231\225\355\225\234 \352\262\275\352\263\240 UI\353\245\274 \353\205\270\354\266\234\355\225\230\352\263\240 \354\202\254\354\232\251\354\235\204 \354\240\234\355\225\234\355\225\251\353\213\210\353\213\244 (\"\354\235\264 \354\204\234\353\271\204\354\212\244\353\212\224 Chrome \353\230\220\353\212\224 Edge \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220 \354\265\234\354\240\201\355\231\224\353\220\230\354\226\264 \354\236\210\354\212\265\353\213\210\353\213\244.\").\n- **\352\266\214\355\225\234 \354\234\240\353\217\204**: \"\353\205\271\354\235\214 \354\213\234\354\236\221\" \353\262\204\355\212\274 \355\201\264\353\246\255 \354\213\234 \353\270\214\353\235\274\354\232\260\354\240\200 \353\247\210\354\235\264\355\201\254 \352\266\214\355\225\234\354\235\204 \354\232\224\354\262\255\355\225\230\353\251\260, \352\261\260\353\266\200\353\220\230\354\227\210\354\235\204 \352\262\275\354\232\260 \354\247\201\352\264\200\354\240\201\354\235\270 \353\252\250\353\213\254 \354\225\210\353\202\264\353\245\274 \354\240\234\352\263\265\355\225\251\353\213\210\353\213\244.\n\n### 3.2 Web Speech API \354\227\260\353\217\231 \353\260\217 \354\236\220\353\217\231 \354\236\254\354\213\234\354\236\221 \353\241\234\354\247\201 (\355\225\265\354\213\254)\n- **\352\270\260\353\263\270 \354\230\265\354\205\230**:\n  ```javascript\n  recognition.lang = \'ko-KR\';\n  recognition.continuous = true;\n  recognition.interimResults = true;\n\n  - \354\244\221\353\213\250 \355\230\204\354\203\201 \354\232\260\355\232\214 \354\262\230\353\246\254 (Continuous Restart):\n      - Web Speech API\353\212\224 \353\260\234\355\231\224\352\260\200 \354\235\274\354\240\225 \354\213\234\352\260\204 \353\251\210\354\266\224\352\261\260\353\202\230 \353\204\244\355\212\270\354\233\214\355\201\254 \355\231\230\352\262\275\354\227\220 \354\235\230\355\225\264 \354\236\220\353\217\231\354\234\274\353\241\234 onend \354\235\264\353\262\244\355\212\270\352\260\200 \355\230\270\354\266\234\353\220\230\353\251\260 \353\251\210\354\266\224\353\212\224 \355\212\271\354\204\261\354\235\264\n        \354\236\210\354\212\265\353\213\210\353\213\244.\n      - \355\225\264\352\262\260 \353\260\251\354\225\210: \354\202\254\354\232\251\354\236\220\352\260\200 \"\354\235\274\354\213\234\354\240\225\354\247\200\" \353\230\220\353\212\224 \"\354\244\221\354\247\200\" \353\262\204\355\212\274\354\235\204 \354\247\201\354\240\221 \353\210\204\353\245\264\354\247\200 \354\225\212\354\235\200 \354\203\201\355\203\234(isRecording === true)\354\227\220\354\204\234\n        onend \354\235\264\353\262\244\355\212\270\352\260\200 \352\260\220\354\247\200\353\220\230\353\251\264, API\353\245\274 \354\246\211\354\213\234 \354\236\254\354\213\234\354\236\221(recognition.start()) \354\213\234\354\274\234 \354\227\260\354\206\215\354\204\261\354\235\204 \354\234\240\354\247\200\355\225\230\353\212\224 \354\203\201\355\203\234 \355\224\214\353\236\230\352\267\270\n        \353\241\234\354\247\201\354\235\204 \352\265\254\355\230\204\355\225\264\354\225\274 \355\225\251\353\213\210\353\213\244.\n  - \354\213\244\354\213\234\352\260\204 \353\215\260\354\235\264\355\204\260 \352\265\254\353\266\204 \354\262\230\353\246\254:\n      - result.isFinal \352\260\222\354\235\204 \352\270\260\354\244\200\354\234\274\353\241\234 \'\355\231\225\354\240\225\353\220\234 \353\260\234\354\226\270 \353\270\224\353\241\235\'\352\263\274 \'\354\213\244\354\213\234\352\260\204 \354\236\221\354\204\261 \354\244\221\354\235\270 \354\236\204\354\213\234 \353\270\224\353\241\235(Interim)\'\354\235\204 \354\227\204\352\262\251\355\236\210\n        \352\265\254\353\266\204\355\225\251\353\213\210\353\213\244.\n      - \355\231\225\354\240\225(isFinal === true) \354\213\234 \355\225\264\353\213\271 \355\205\215\354\212\244\355\212\270\353\245\274 \355\203\200\354\236\204\353\235\274\354\235\270 \353\260\260\354\227\264\354\227\220 \352\263\240\354\234\240 ID, \355\203\200\354\236\204\354\212\244\355\203\254\355\224\204, \355\230\204\354\236\254 \354\204\240\355\203\235\353\220\234 \355\231\234\354\204\261 \355\231\224\354\236\220 \354\240\225\353\263\264\354\231\200\n        \355\225\250\352\273\230 \352\260\235\354\262\264\353\241\234 push\355\225\251\353\213\210\353\213\244.\n\n3.3 \355\231\224\354\236\220 \352\264\200\353\246\254 \353\260\217 \354\210\230\353\217\231 \355\203\234\352\271\205\n\n  - \352\270\260\353\263\270 \355\231\234\354\204\261 \