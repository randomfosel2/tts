      replacement_content: "  const [meetingTitle, setMeetingTitle] = useState<string>(() => {\n    if (typeof window === \"undefined\") return \"\353\214\200\353\252\250\354\202\260 \355\230\270\355\205\224 \354\202\254\354\227\205\353\266\200 \354\240\225\352\270\260 \355\230\204\354\225\210 \355\232\214\354\235\230\";\n    try {\n      const saved = localStorage.getItem(\"current_meeting\");\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (parsed.title) return parsed.title;\n      }\n    } catch (e) {}\n    return \"\353\214\200\353\252\250\354\202\260 \355\230\270\355\205\224 \354\202\254\354\227\205\353\266\200 \354\240\225\352\270\260 \355\230\204\354\225\210 \355\232\214\354\235\230\";\n  });\n  const [attendees, setAttendees] = useState<Attendee[]>(() => {\n    const defaults = [\n      { id: \"1\", name: \"\354\260\270\354\204\235\354\236\220 A\", color: \"blue\" },\n      { id: \"2\", name: \"\354\260\270\354\204\235\354\236\220 B\", color: \"emerald\" },\n    ];\n    if (typeof window === \"undefined\") return defaults;\n    try {\n      const saved = localStorage.getItem(\"current_meeting\");\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (parsed.attendees && parsed.attendees.length > 0) return parsed.attendees;\n      }\n    } catch (e) {}\n    return defaults;\n  });\n  const [newAttendeeName, setNewAttendeeName] = useState<string>(\"\");\n  const [newAttendeeColor, setNewAttendeeColor] = useState<string>(\"blue\");\n  \n  const [activeSpeakerId, setActiveSpeakerId] = useState<string>(\"1\");\n  const [isRecording, setIsRecording] = useState<boolean>(false);\n  const [micState, setMicState] = useState<\"not-requested\" | \"authorized\" | \"denied\">(\"not-requested\");\n  const [transcript, setTranscript] = useState<TimelineItem[]>(() => {\n    if (typeof window === \"undefined\") return [];\n    try {\n      const saved = localStorage.getItem(\"current_meeting\");\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (parsed.transcript) return parsed.transcript;\n      }\n    } catch (e) {}\n    return [];\n  });\n  const [interimResult, setInterimResult] = useState<string>(\"\");\n  \n  // Storage & History States\n  const [meetingHistory, setMeetingHistory] = useState<SavedMeeting[]>(() => {\n    if (typeof window === \"undefined\") return [];\n    try {\n      const history = localStorage.getItem(\"meeting_history\");\n      if (history) return JSON.parse(history);\n    } catch (e) {}\n    return [];\n  });\n  const [selectedHistoryId, setSelectedHistoryId] = useState<string | null>(null);\n  \n  // Custom Warnings & Indicators\n  const [isSilenceAlert, setIsSilenceAlert] = useState<boolean>(false);\n  const [showNotification, setShowNotification] = useState<{ type: \"success\" | \"error\" | \"info\"; msg: string } | null>(null);\n  \n  // AI Summary States\n  const [aiSummary, setAiSummary] = useState<string>(() => {\n    if (typeof window === \"undefined\") return \"\";\n    try {\n      const saved = localStorage.getItem(\"current_meeting\");\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (parsed.aiSummary) return parsed.aiSummary;\n      }\n    } catch (e) {}\n    return \"\";\n  });\n  const [isAiLoading, setIsAiLoading] = useState<boolean>(false);"
