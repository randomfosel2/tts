\242\205 \354\240\200\354\236\245: \"\355\232\214\354\235\230 \354\231\204\353\243\214 \353\260\217 \354\240\200\354\236\245\"\354\235\204 \353\210\204\353\245\264\353\251\264 \355\230\204\354\236\254 \354\203\201\355\203\234\353\245\274 \354\235\264\353\240\245 \353\252\251\353\241\235(meeting_history \353\260\260\354\227\264)\354\234\274\353\241\234 \354\240\200\354\236\245\355\225\230\352\263\240\n    current_meeting\354\235\200 \353\271\204\354\233\201\353\213\210\353\213\244.\n  - \354\235\264\353\240\245 \353\266\210\353\237\254\354\230\244\352\270\260: \354\235\264\354\240\204 \355\232\214\354\235\230 \354\235\264\353\240\245 \353\252\251\353\241\235\354\235\204 \355\201\264\353\246\255\355\225\230\353\251\264 \353\251\224\354\235\270 \355\231\224\353\251\264\354\235\230 \355\203\200\354\236\204\353\235\274\354\235\270 \354\203\201\355\203\234\352\260\222\354\234\274\353\241\234 \353\215\256\354\226\264\354\224\214\354\233\214 \354\235\264\354\226\264\354\204\234 \353\263\264\352\261\260\353\202\230 \355\216\270\354\247\221\355\225\240 \354\210\230 \354\236\210\352\262\214 \355\225\251\353\213\210\353\213\244.\n\n3.6 \353\215\260\354\235\264\355\204\260 \353\202\264\353\263\264\353\202\264\352\270\260 (Export)\n\n  - \355\205\215\354\212\244\355\212\270 \355\214\214\354\235\274 \353\213\244\354\232\264\353\241\234\353\223\234 (.txt):\n      - \355\214\214\354\235\274 \354\235\264\353\246\204 \355\217\254\353\247\267: [\355\232\214\354\235\230\354\240\234\353\252\251]_\353\205\204\354\233\224\354\235\274_\354\213\234\353\266\204.txt\n      - \355\205\215\354\212\244\355\212\270 \352\265\254\354\241\260:\n        [\355\232\214\354\235\230\353\241\235] \355\232\214\354\235\230 \354\240\234\353\252\251\n        \354\235\274\354\213\234: YYYY-MM-DD HH:mm:ss\n        \354\260\270\354\204\235\354\236\220 \353\252\251\353\241\235: \354\260\270\354\204\235\354\236\220 A, \354\260\270\354\204\235\354\236\220 B...\n        --------------------------------------\n       