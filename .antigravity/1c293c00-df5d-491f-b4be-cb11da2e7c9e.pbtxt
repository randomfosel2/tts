234\354\242\205 \354\240\200\354\236\245: \"\355\232\214\354\235\230 \354\231\204\353\243\214 \353\260\217 \354\240\200\354\236\245\"\354\235\204 \353\210\204\353\245\264\353\251\264 \355\230\204\354\236\254 \354\203\201\355\203\234\353\245\274 \354\235\264\353\240\245 \353\252\251\353\241\235(meeting_history \353\260\260\354\227\264)\354\234\274\353\241\234 \354\240\200\354\236\245\355\225\230\352\263\240\n    current_meeting\354\235\200 \353\271\204\354\233\201\353\213\210\353\213\244.\n  - \354\235\264\353\240\245 \353\266\210\353\237\254\354\230\244\352\270\260: \354\235\264\354\240\204 \355\232\214\354\235\230 \354\235\264\353\240\245 \353\252\251\353\241\235\354\235\204 \355\201\264\353\246\255\355\225\230\353\251\264 \353\251\224\354\235\270 \355\231\224\353\251\264\354\235\230 \355\203\200\354\236\204\353\235\274\354\235\270 \354\203\201\355\203\234\352\260\222\354\234\274\353\241\234 \353\215\256\354\226\264\354\224\214\354\233\214 \354\235\264\354\226\264\354\204\234 \353\263\264\352\261\260\353\202\230 \355\216\270\354\247\221\355\225\240 \354\210\230 \354\236\210\352\262\214 \355\225\251\353\213\210\353\213\244.\n\n3.6 \353\215\260\354\235\264\355\204\260 \353\202\264\353\263\264\353\202\264\352\270\260 (Export)\n\n  - \355\205\215\354\212\244\355\212\270 \355\214\214\354\235\274 \353\213\244\354\232\264\353\241\234\353\223\234 (.txt):\n      - \355\214\214\354\235\274 \354\235\264\353\246\204 \355\217\254\353\247\267: [\355\232\214\354\235\230\354\240\234\353\252\251]_\353\205\204\354\233\224\354\235\274_\354\213\234\353\266\204.txt\n      - \355\205\215\354\212\244\355\212\270 \352\265\254\354\241\260:\n        [\355\232\214\354\235\230\353\241\235] \355\232\214\354\235\230 \354\240\234\353\252\251\n        \354\235\274\354\213\234: YYYY-MM-DD HH:mm:ss\n        \354\260\270\354\204\235\354\236\220 \353\252\251\353\241\235: \354\260\270\354\204\235\354\236\220 A, \354\260\270\354\204\235\354\236\220 B...\n        --------------------------------------\n        [00:15 / \354\260\270\354\204\235\354\236\220 A] \354\225\210\353\205\225\355\225\230\354\204\270\354\232\224. \354\230\244\353\212\230 \355\232\214\354\235\230 \354\225\210\352\261\264\354\235\200...\n        [01:02 / \354\260\270\354\204\235\354\236\220 B] \353\204\244, \355\231\225\354\235\270\355\226\210\354\212\265\353\213\210\353\213\244. \352\264\200\353\240\250 \354\236\220\353\243\214\353\212\224...\n  - \353\247\210\355\201\254\353\213\244\354\232\264 \355\201\264\353\246\275\353\263\264\353\223\234 \353\263\265\354\202\254:\n      - \355\221\234\353\202\230 \353\246\254\354\212\244\355\212\270 \355\230\225\355\203\234\353\241\234 \354\240\225\353\246\254\353\220\234 \352\260\200\353\217\205\354\204\261 \353\206\222\354\235\200 Markdown \353\254\270\353\262\225 \355\230\225\355\203\234\353\241\234 \355\201\264\353\246\275\353\263\264\353\223\234\354\227\220 \353\260\224\353\241\234 \353\263\265\354\202\254\353\220\230\353\217\204\353\241\235 \352\265\254\355\230\204\355\225\251\353\213\210\353\213\244.\n\n4. \354\230\210\354\231\270 \354\262\230\353\246\254 \353\260\217 UX \352\263\240\353\240\244\354\202\254\355\225\255\n\n1.  \353\260\261\352\267\270\353\235\274\354\232\264\353\223\234 \355\203\255 \355\225\234\352\263\204 \354\225\210\353\202\264:\n      - Web Speech API\353\212\224 \353\270\214\353\235\274\354\232\260\354\240\200 \355\203\255\354\235\264 \353\260\261\352\267\270\353\235\274\354\232\264\353\223\234(\353\271\204\355\231\234\354\204\261 \355\203\255)\353\241\234 \354\235\264\353\217\231\355\225\230\352\261\260\353\202\230 \355\231\224\353\251\264\354\235\264 \352\272\274\354\247\210 \352\262\275\354\232\260 \353\263\264\354\225\210 \354\240\225\354\261\205\354\203\201 \354\236\221\353\217\231\354\235\264 \353\251\210\354\266\224\352\261\260\353\202\230\n        \353\205\271\354\235\214\354\235\264 \353\266\210\354\231\204\354\240\204\355\225\264\354\247\210 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n      - UX \353\263\264\354\231\204: \353\251\224\354\235\270 \355\231\224\353\251\264 \353\205\271\354\235\214 \354\230\201\354\227\255 \352\267\274\354\262\230\354\227\220 \"\354\225\210\354\240\225\354\240\201\354\235\270 \353\205\271\354\235\214\354\235\204 \354\234\204\355\225\264 \353\263\270 \353\270\214\353\235\274\354\232\260\354\240\200 \355\203\255\354\235\204 \355\231\234\354\204\261\355\231\224(\354\240\204\353\251\264 \354\234\240\354\247\200) \354\203\201\355\203\234\353\241\234 \354\234\240\354\247\200\355\225\264 \354\243\274\354\204\270\354\232\224\"\353\235\274\353\212\224\n        \354\225\210\353\202\264 \353\254\270\352\265\254\353\245\274 \354\203\201\354\213\234 \355\221\234\352\270\260\355\225\251\353\213\210\353\213\244.\n2.  \353\204\244\355\212\270\354\233\214\355\201\254 \354\210\234\354\213\234 \353\201\212\352\271\200 \353\214\200\354\235\221:\n      - onerror \354\235\264\353\262\244\355\212\270 \354\244\221 network \352\264\200\353\240\250 \354\227\220\353\237\254\352\260\200 \353\260\234\354\203\235\355\225\240 \352\262\275\354\232\260 \354\225\214\353\246\274\354\235\204 \353\235\204\354\232\260\352\263\240 \354\236\220\353\217\231\354\234\274\353\241\234 \354\236\254\354\227\260\352\262\260\354\235\204 \354\213\234\353\217\204\355\225\230\353\212\224 \353\263\265\352\265\254 \353\241\234\354\247\201\354\235\204 \354\266\224\352\260\200\355\225\251\353\213\210\353\213\244.\n3.  \353\247\210\354\235\264\355\201\254 \353\254\264\354\235\214 \354\247\200\354\206\215 \354\262\230\353\246\254:\n      - \354\235\214\354\204\261 \354\236\205\353\240\245\354\235\264 30\354\264\210 \354\235\264\354\203\201 \354\240\204\355\230\200 \352\260\220\354\247\200\353\220\230\354\247\200 \354\225\212\354\235\204 \352\262\275\354\232\260 \354\206\214\353\252\250\354\240\201\354\235\270 API \354\236\254\355\230\270\354\266\234 \353\243\250\355\224\204\353\245\274 \353\260\251\354\247\200\355\225\230\352\270\260 \354\234\204\355\225\264 \354\202\254\354\232\251\354\236\220\354\227\220\352\262\214 \354\235\274\354\213\234\354\240\225\354\247\200 \354\203\201\355\203\234\354\236\204\354\235\204\n        \355\231\230\352\270\260\355\225\230\353\212\224 \353\257\270\354\204\270\355\225\234 \354\247\204\353\217\231 \355\232\250\352\263\274\353\202\230 \354\213\234\352\260\201\354\240\201 \353\261\203\354\247\200\353\245\274 \354\240\234\352\263\265\355\225\251\353\213\210\353\213\244.\n\n\n---\n\n### \354\247\204\355\226\211 \354\225\210\353\202\264\n\354\202\254\354\232\251\355\225\230\352\263\240 \352\263\204\354\213\240 AI Studio\353\202\230 Cursor \353\223\261\354\235\230 \355\224\204\353\241\254\355\224\204\355\212\270 \354\260\275\354\227\220 **\"\354\234\204 PRD\353\245\274 \353\260\224\355\203\225\354\234\274\353\241\234 Vite + React + Tailwind CSS \355\231\230\352\262\275\354\227\220\354\204\234 \354\236\221\353\217\231\355\225\230\353\212\224 \354\231\204\354\240\204\355\225\230\352\263\240 \353\217\205\353\246\275\354\240\201\354\235\270 \354\273\264\355\217\254\353\204\214\355\212\270 \354\275\224\353\223\234\353\245\274 \354\236\221\354\204\261\355\225\264 \354\244\230.\"**\353\235\274\352\263\240 \354\236\205\353\240\245\355\225\230\354\213\234\353\251\264 \353\260\224\353\241\234 \354\236\221\353\217\231 \352\260\200\353\212\245\355\225\234 \354\210\230\354\244\200\354\235\230 \354\275\224\353\223\234\353\245\274 \354\240\234\352\263\265\353\260\233\354\234\274\354\213\244 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244. \354\266\224\352\260\200\353\241\234 \354\210\230\354\240\225\354\235\264 \355\225\204\354\232\224\355\225\230\352\261\260\353\202\230 \353\263\264\354\231\204\355\225\230\352\263\240 \354\213\266\354\234\274\354\213\240 \353\266\200\353\266\204\354\235\264 \354\236\210\353\213\244\353\251\264 \354\226\270\354\240\234\353\223\240 \355\216\270\355\225\230\352\262\214 \353\247\220\354\224\200\355\225\264 \354\243\274\354\213\234\352\270\260 \353\260\224\353\236\215\353\213\210\353\213